---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="404 — Not found · Igor Khokhriakov">
  <Nav />

  <main id="main">
    <section class="not-found">
      <div class="container">
        <p class="code mono">404</p>
        <p class="message">
          This page degraded silently and is no longer here.
        </p>
        <a href="/" class="back-link mono">← Back to ingvord.github.io</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 60vh;
    border-top: none;
  }

  .code {
    position: relative;
    display: inline-block;
    overflow: hidden;
    font-family: var(--font-display);
    font-stretch: expanded;
    font-weight: 800;
    font-size: clamp(5rem, 22vw, 12rem);
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--trace);
    padding-right: 0.1em;
    filter: drop-shadow(3px 0 0 color-mix(in srgb, var(--p99) 55%, transparent))
            drop-shadow(-3px 0 0 color-mix(in srgb, var(--trace) 35%, transparent));
    line-height: 1;
    margin: 0;
  }

  /* Scanline sweep: transform only */
  .code::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 18%;
    background: linear-gradient(transparent, var(--glow), transparent);
    animation: scan 3.2s linear infinite;
  }

  @keyframes scan {
    from { transform: translateY(-100%); }
    to { transform: translateY(560%); }
  }

  .message {
    margin-top: 1rem;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .back-link {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.85rem;
    color: var(--trace);
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--text);
  }
</style>
