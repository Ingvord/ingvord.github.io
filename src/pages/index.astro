---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroTrace from '../components/HeroTrace.astro';
---

<Base
  title="Igor Khokhriakov — Staff Software Engineer"
  description="Staff Software Engineer specializing in Java/JVM, distributed systems, Kubernetes, and Elasticsearch. 17 years finding and removing the blockers that slow down the next phase of work."
>
  <Nav />

  <main id="main">
    <!-- ─── HERO ─── -->
    <section class="hero" aria-labelledby="hero-headline">
      <div class="container">
        <p class="hero-eyebrow glass mono" data-reveal>
          <span class="led" aria-hidden="true"></span>
          Java / JVM · Distributed Systems · Kubernetes · Elasticsearch
        </p>

        <h1 id="hero-headline" data-reveal>
          <span class="outline">Distributed systems</span><br />don't fail loudly.
        </h1>

        <p class="hero-prose" data-reveal>
          They degrade quietly, accumulate debt silently, and block the next phase of work
          long before anyone names the blocker. I've spent 17 years finding those blockers
          and removing them.
        </p>

        <HeroTrace />

        <div class="hero-cta" data-reveal>
          <a href="#proof" class="btn btn-primary">Read the proof ↓</a>
          <a href="mailto:ingvord.mail@gmail.com" class="btn btn-secondary">
            Message me — I respond to everything <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── THE WORK TAKES THREE FORMS ─── -->
    <section id="proof" aria-labelledby="work-heading">
      <div class="container">
        <p class="section-marker">The work takes three forms</p>

        <!-- 1 · Build -->
        <div class="work-block glass spotlight" data-reveal>
          <span class="work-index outline" aria-hidden="true">01</span>
          <h2 class="work-number" id="work-heading">
            Build the platform that makes the next thing possible
          </h2>

          <div class="work-body">
            <p>
              RCSB Protein Data Bank (<span class="metric">5B requests/yr</span>,
              <span class="metric">14.5M users</span>): integrated Elastic APM,
              surfaced sequential Elasticsearch execution no application metric had caught,
              cut P99 latency <span class="metric">33%</span> with zero caller-code changes.
            </p>
            <p class="proof-row">
              <a href="https://www.youtube.com/watch?v=pWB1t2m6pnY" target="_blank" rel="noopener" class="proof-link">[video: SCaLE 20x — RCSB → K8s]</a>
              <a href="https://www.slideshare.net/slideshow/we3bco04talkpdf/263549945" target="_blank" rel="noopener" class="proof-link">[slides: Observability with Elastic APM]</a>
            </p>

            <p>
              DESY: ISPyB refactor that let the beamline team bring one of the facility's most
              commercially significant beamlines live.
            </p>

            <p>
              OpenStack → Kubernetes migration:
              <span class="metric">$200K</span> direct savings.
            </p>
            <p class="proof-row">
              <a href="https://www.wearedevelopers.com/en/videos/1055/how-i-saved-200k-yr-in-direct-costs-writing-0-code-lines-in-k8s" target="_blank" rel="noopener" class="proof-link">[video: WeAreDevelopers World Congress 2024]</a>
            </p>

            <p>
              Now building: a fully automated trading-strategy platform — concept to live
              production with no manual handoffs.
            </p>
            <p class="proof-row">
              <a href="/trading-platform/" class="proof-link">[case study]</a>
            </p>
          </div>
        </div>

        <!-- 2 · Evidence -->
        <div class="work-block glass spotlight" data-reveal>
          <span class="work-index outline" aria-hidden="true">02</span>
          <h2 class="work-number">
            Generate the evidence that prevents the wrong thing from being built
          </h2>

          <div class="work-body">
            <p>
              Code-level assessment of a distributed storage engine: modeled
              <span class="metric">5×–10×</span> growth, located where metadata coordination,
              request fan-out, and object-storage latency combine into production constraints —
              before any appeared.
            </p>

            <p>
              <span class="metric">72-scenario</span> load study of SciCat's metadata API;
              showed <span class="metric">20+</span> European and US facilities where their
              scaling ceiling sits.
            </p>
            <p class="proof-row">
              <a href="https://indico.esrf.fr/event/114/contributions/777/" target="_blank" rel="noopener" class="proof-link">[paper: NOBUGS 2024]</a>
              <a href="https://doi.org/10.5281/zenodo.15056189" target="_blank" rel="noopener" class="proof-link">[DOI: 10.5281/zenodo.15056189]</a>
            </p>
          </div>
        </div>

        <!-- 3 · Method -->
        <div class="work-block glass spotlight" data-reveal>
          <span class="work-index outline" aria-hidden="true">03</span>
          <h2 class="work-number">
            Extract the method and leave it behind
          </h2>

          <div class="work-body">
            <p>
              Tango REST specification → industry standard across
              <span class="metric">100+</span> facilities.
            </p>

            <p>
              Published, reusable benchmarking framework and load-testing methodology.
            </p>
            <p class="proof-row">
              <a href="/waltz/" class="proof-link">[case study]</a>
              <a href="https://zenodo.org/search?q=khokhriakov" target="_blank" rel="noopener" class="proof-link">[Zenodo records]</a>
              <a href="https://github.com/scientific-software-hub/waltz" target="_blank" rel="noopener" class="proof-link">[GitHub: waltz]</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── STILL SHIPPING ─── -->
    <section aria-labelledby="shipping-heading">
      <div class="container">
        <p class="section-marker">Still shipping</p>
        <p id="shipping-heading" class="shipping-statement">
          Production Java is where I'm sharpest — including low-level
          <code>Unsafe</code>-based work — and I intend to keep shipping it.
        </p>
        <ul class="stack-pills mono" aria-label="Production stack">
          <li>Java/JVM</li>
          <li>Node/TypeScript</li>
          <li>Rust</li>
          <li>C++</li>
          <li>ELK</li>
          <li>Kubernetes</li>
        </ul>
        <p class="stack-note">
          Python for tooling and analysis, not production.
        </p>
      </div>
    </section>

    <!-- ─── SELECTED TALKS ─── -->
    <section aria-labelledby="talks-heading">
      <div class="container">
        <p class="section-marker">Selected talks</p>
        <h2 id="talks-heading" class="sr-only">Selected talks</h2>

        <ol class="talks-list">
          <li class="talk-row" data-reveal>
            <div class="talk-main">
              <span class="talk-title">Reactive Programming for Tango-Controls</span>
              <span class="talk-meta mono">40th Tango Users Meeting · 2026</span>
            </div>
            <p class="talk-why">Composing async event streams from heterogeneous scientific instruments with shared upstream multicast — operator UIs stay live without polling.</p>
            <div class="talk-links">
              <a href="https://indico.tango-controls.org/event/737/contributions/1009/" target="_blank" rel="noopener" class="proof-link">[slides]</a>
              <a href="https://youtu.be/9CyGPIwJlxc" target="_blank" rel="noopener" class="proof-link">[video]</a>
            </div>
          </li>

          <li class="talk-row" data-reveal>
            <div class="talk-main">
              <span class="talk-title">How I Saved $200K with 0 Code in K8s</span>
              <span class="talk-meta mono">WeAreDevelopers World Congress · 2024</span>
            </div>
            <p class="talk-why">Infrastructure cost reduction as a platform decision — VPA + rightsizing found savings the migration itself had missed.</p>
            <div class="talk-links">
              <a href="https://www.wearedevelopers.com/en/videos/1055/how-i-saved-200k-yr-in-direct-costs-writing-0-code-lines-in-k8s" target="_blank" rel="noopener" class="proof-link">[video]</a>
            </div>
          </li>

          <li class="talk-row" data-reveal>
            <div class="talk-main">
              <span class="talk-title">Performance Benchmarking of Node.js, Rust, Python and Go</span>
              <span class="talk-meta mono">NOBUGS 2024</span>
            </div>
            <p class="talk-why">Methodology for eliminating toolchain bias from benchmark results across four runtimes at 20+ facilities.</p>
            <div class="talk-links">
              <a href="https://youtu.be/IrM5LyRrsN0" target="_blank" rel="noopener" class="proof-link">[video]</a>
              <a href="https://doi.org/10.5281/zenodo.15056189" target="_blank" rel="noopener" class="proof-link">[DOI]</a>
            </div>
          </li>

          <li class="talk-row" data-reveal>
            <div class="talk-main">
              <span class="talk-title">Migrating RCSB.org to Kubernetes</span>
              <span class="talk-meta mono">SCaLE 20x · 2023</span>
            </div>
            <p class="talk-why">How a migration becomes an observability project when you instrument first.</p>
            <div class="talk-links">
              <a href="https://www.youtube.com/watch?v=pWB1t2m6pnY" target="_blank" rel="noopener" class="proof-link">[video]</a>
            </div>
          </li>
        </ol>

        <p class="talks-more">
          <a href="/talks/" class="mono">Full list of talks →</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ── Hero ── */
  .hero {
    padding-block: clamp(4rem, 10vw, 7rem);
    border-top: none;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.03em;
    margin-bottom: 1.75rem;
  }

  .hero h1 .outline {
    display: inline-block;
    padding-bottom: 0.05em;
  }

  .hero-prose {
    margin-top: 1.5rem;
    max-width: 55ch;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    padding: 0.75em 1.35em;
    border-radius: 6px;
    border: 1px solid transparent;
    background-image: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.3s ease,
                color 0.2s ease, border-color 0.2s ease;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-primary {
    background-color: var(--trace);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 10px 28px -10px var(--trace), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  /* Sheen sweep: transform only */
  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.55) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 0.7s var(--ease-out);
  }

  .btn-primary:hover {
    box-shadow: 0 14px 34px -8px var(--trace), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .btn-primary:hover::after {
    transform: translateX(120%);
  }

  .btn-secondary {
    padding-inline: 0.25em;
    color: var(--trace);
    border-color: transparent;
    border-radius: 2px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* ── Work blocks: numeral rail + content, joined by a trace spine ── */
  .work-block {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(1rem, 4vw, 2.5rem);
    align-items: start;
    margin-bottom: 2.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .work-block:last-child {
    margin-bottom: 0;
  }

  .work-block:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(clamp(1.25rem, 3vw, 2rem) + 1.6rem);
    top: 100%;
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(var(--trace), transparent);
    opacity: 0.6;
  }

  .work-index {
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-stretch: expanded;
    font-weight: 800;
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    -webkit-text-stroke-color: var(--trace);
    background-image: linear-gradient(90deg, var(--trace), var(--trace));
  }

  .work-number {
    grid-column: 2;
    margin-bottom: 1.25rem;
  }

  .work-body {
    grid-column: 2;
  }

  .work-body p + p {
    margin-top: 1em;
  }

  .proof-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem !important;
  }

  /* ── Still shipping ── */
  .shipping-statement {
    font-size: 1.05rem;
    margin: 0;
  }

  .stack-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0;
  }

  .stack-pills li {
    margin: 0;
    padding: 0.3em 0.8em;
    color: var(--trace);
    font-size: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--trace) 40%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--trace) 7%, transparent);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s ease;
  }

  .stack-pills li:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px var(--trace);
  }

  .shipping-statement code {
    color: var(--p99);
    text-shadow: 0 0 12px color-mix(in srgb, var(--p99) 50%, transparent);
  }

  .stack-note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* ── Talks ── */
  .talks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: talks;
  }

  .talk-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .talk-row:last-child {
    border-bottom: none;
  }

  /* Trace bar grows on hover (scaleY only); content nudges via its children, not the revealed row */
  .talk-row::before {
    content: '';
    position: absolute;
    left: -1rem;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: var(--trace);
    box-shadow: 0 0 12px var(--trace);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform 0.35s var(--ease-out);
  }

  .talk-row:hover::before {
    transform: scaleY(1);
  }

  .talk-main,
  .talk-why {
    transition: transform 0.35s var(--ease-out);
  }

  .talk-row:hover .talk-main,
  .talk-row:hover .talk-why {
    transform: translateX(6px);
  }

  .talk-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .talk-title {
    font-weight: 600;
    color: var(--text);
  }

  .talk-meta {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .talk-why {
    grid-column: 1;
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
  }

  .talk-links {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .talks-more {
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  .talks-more a {
    color: var(--muted);
  }

  .talks-more a:hover {
    color: var(--trace);
    opacity: 1;
  }

  /* ── Utilities ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .work-block {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-index {
      grid-row: auto;
      margin-bottom: 0.75rem;
    }
    .work-number,
    .work-body {
      grid-column: 1;
    }
    .work-block:not(:last-child)::after {
      left: 2rem;
    }
  }

  @media (max-width: 520px) {
    .talk-row {
      grid-template-columns: 1fr;
    }
    .talk-links {
      grid-row: auto;
      grid-column: 1;
      margin-top: 0.5rem;
    }
  }
</style>
