---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Staff Software Engineer · Java/JVM · Distributed Systems · Kubernetes · Elasticsearch',
  ogImage = '/og-default.png',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://ingvord.github.io';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme: applied before first paint to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      const root = document.documentElement;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer: fine)').matches;

      // Reveal on scroll, staggered by index within the parent
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      targets.forEach((el) => {
        const siblings = el.parentElement
          ? Array.from(el.parentElement.querySelectorAll(':scope > [data-reveal]'))
          : [];
        el.style.setProperty('--i', String(Math.max(0, siblings.indexOf(el))));
      });

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }

      // Cursor light: glow layer follows the pointer (--sx/--sy lights the hovered card border)
      const glow = document.querySelector<HTMLElement>('.cursor-glow');
      if (glow && fine && !reduced) {
        let frame = 0;
        let x = 0;
        let y = 0;
        let target: EventTarget | null = null;
        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            target = e.target;
            if (frame || document.hidden) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const card = (target as HTMLElement | null)?.closest?.<HTMLElement>('.spotlight');
              const r = card?.getBoundingClientRect();
              glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
              glow.classList.add('is-on');
              if (card && r) {
                card.style.setProperty('--sx', `${x - r.left}px`);
                card.style.setProperty('--sy', `${y - r.top}px`);
              }
            });
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
